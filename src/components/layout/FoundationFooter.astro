---
// Responsive Footer with 12-column grid and exact 3-column link alignment
---

<footer class="bg-[#191c1d] text-[#bbcabf] pt-20 pb-12 rounded-t-[2.5rem] mt-10 border-t border-[#2e3132] font-['Manrope']">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Top Grid Container (12 Columns) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 pb-16 border-b border-[#2e3132]">
      
      {/* Left Area: 3-Column Footer Links (7 Columns) */}
      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm">
        
        {/* Column 1 */}
        <div class="flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-[0.05em] text-[#4edea3]">Navigation</span>
          <ul class="flex flex-col gap-3 text-xs sm:text-sm">
            <li>
              <a href="#home" class="text-white font-medium hover:text-[#4edea3] transition-colors">
                Home
              </a>
            </li>
            <li>
              <a href="/about" class="hover:text-white transition-colors">
                About Foundation
              </a>
            </li>
            <li>
              <a href="#causes" class="hover:text-white transition-colors">
                Our Causes
              </a>
            </li>
            <li>
              <a href="#volunteers" class="hover:text-white transition-colors">
                Volunteer Programs
              </a>
            </li>
            <li>
              <a href="/events" class="hover:text-white transition-colors">
                Upcoming Events
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors">
                Contact Us
              </a>
            </li>
          </ul>
        </div>

        {/* Column 2 */}
        <div class="flex flex-col gap-4">
          <span class="text-xs font-bold uppercase tracking-[0.05em] text-[#4edea3]">Support & Care</span>
          <ul class="flex flex-col gap-3 text-xs sm:text-sm">
            <li>
              <a href="#donate" class="hover:text-white transition-colors">
                Donate Online
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors">
                Become a Partner
              </a>
            </li>
            <li>
              <a href="#causes" class="hover:text-white transition-colors">
                Ration Drives
              </a>
            </li>
            <li>
              <a href="#causes" class="hover:text-white transition-colors">
                Tree Plantation
              </a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white transition-colors">
                Emergency Relief
              </a>
            </li>
          </ul>
        </div>

        {/* Column 3 */}
        <div class="flex flex-col gap-4 col-span-2 sm:col-span-1">
          <span class="text-xs font-bold uppercase tracking-[0.05em] text-[#4edea3]">Resources</span>
          <ul class="flex flex-col gap-3 text-xs sm:text-sm">
            <li>
              <a href="/events" class="hover:text-white transition-colors">
                Impact Stories
              </a>
            </li>
            <li>
              <a href="#" class="hover:text-white transition-colors">
                Privacy Policy
              </a>
            </li>
            <li>
              <a href="#" class="hover:text-white transition-colors">
                Terms of Service
              </a>
            </li>
          </ul>
        </div>

      </div>

      {/* Right Area: Newsletter Subscription (5 Columns) */}
      <div class="lg:col-span-5 flex flex-col items-start lg:items-end lg:text-right space-y-4">
        <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          Subscribe to Updates
        </h3>
        <p class="text-xs sm:text-sm text-[#bbcabf] max-w-sm leading-relaxed">
          Join our newsletter to receive quarterly community impact summaries, volunteer opportunities, and seasonal relief updates.
        </p>

        {/* Form Box with 8px radius */}
        <form class="flex w-full max-w-md bg-[#2e3132] rounded-[8px] p-1.5 border border-[#6c7a71]/40 shadow-inner" onSubmit="return false;">
          <input
            type="email"
            placeholder="Your email here"
            class="w-full bg-transparent text-white px-4 outline-none text-xs sm:text-sm placeholder-[#bbcabf]/70"
            required
          />
          <button
            type="submit"
            class="bg-[#006c49] hover:bg-[#005a3c] text-white px-6 py-2.5 rounded-[6px] text-xs font-bold uppercase tracking-[0.05em] transition-all shrink-0 cursor-pointer shadow-xs"
          >
            Join
          </button>
        </form>
      </div>

    </div>

    {/* Bottom Bar: White Logo, Social Links & Copyright */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-[#bbcabf] gap-4">
      <div class="flex items-center gap-3">
        <img
          src="/logo_white.jpg"
          alt="InAmigos Foundation Logo"
          class="h-8 w-auto object-contain rounded-[4px]"
        />
        <span>•</span>
        <span>© {new Date().getFullYear()} InAmigos Foundation. All rights reserved.</span>
      </div>

      {/* Social Media Links */}
      <div class="flex items-center gap-4 text-white">
        <a
          href="https://www.facebook.com/InAmigos"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="InAmigos Foundation on Facebook"
          class="hover:text-[#4edea3] transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
        <a
          href="https://twitter.com/InamigosF?s=08"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="InAmigos Foundation on Twitter"
          class="hover:text-[#4edea3] transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
        </a>
        <a
          href="https://instagram.com/inamigos?utm_medium=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="InAmigos Foundation on Instagram"
          class="hover:text-[#4edea3] transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
        </a>
        <a
          href="https://www.linkedin.com/company/inamigos-foundation"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="InAmigos Foundation on LinkedIn"
          class="hover:text-[#4edea3] transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a
          href="https://youtube.com/@inamigosfoundation4296"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="InAmigos Foundation on YouTube"
          class="hover:text-[#4edea3] transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="white"></polygon></svg>
        </a>
      </div>
    </div>

  </div>
</footer>
