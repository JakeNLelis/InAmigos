---
// TopBar component with Compassionate Outreach theme & zero-runtime inline SVGs
---

<div class="bg-[#006c49] text-white text-xs py-2.5 px-4 sm:px-8 border-b border-[#005236] font-['Manrope']">
  <div class="max-w-[1280px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5">
    
    {/* Email contact */}
    <div class="flex items-center gap-2 font-medium">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      <a href="mailto:support@inamigosfoundation.org.in" class="hover:underline opacity-95 hover:opacity-100 transition-opacity">
        support@inamigosfoundation.org.in
      </a>
    </div>

    {/* Social Links */}
    <div class="flex items-center gap-4">
      {/* Facebook */}
      <a
        href="https://www.facebook.com/InAmigos"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="InAmigos Foundation on Facebook"
        class="hover:opacity-80 hover:scale-110 transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </a>

      {/* Twitter */}
      <a
        href="https://twitter.com/InamigosF?s=08"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="InAmigos Foundation on Twitter (X)"
        class="hover:opacity-80 hover:scale-110 transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
        </svg>
      </a>

      {/* Instagram */}
      <a
        href="https://instagram.com/inamigos?utm_medium=copy_link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="InAmigos Foundation on Instagram"
        class="hover:opacity-80 hover:scale-110 transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
        </svg>
      </a>

      {/* LinkedIn */}
      <a
        href="https://www.linkedin.com/company/inamigos-foundation"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="InAmigos Foundation on LinkedIn"
        class="hover:opacity-80 hover:scale-110 transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect width="4" height="12" x="2" y="9"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>

      {/* YouTube */}
      <a
        href="https://youtube.com/@inamigosfoundation4296"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="InAmigos Foundation on YouTube"
        class="hover:opacity-80 hover:scale-110 transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
          <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="white"></polygon>
        </svg>
      </a>
    </div>

  </div>
</div>
